{
    "name": "dashed/dashed-ecommerce-rendabiliteit",
    "description": "Profitability reporting for Dashed e-commerce shops",
    "keywords": ["Dashed", "laravel", "dashed-ecommerce-rendabiliteit"],
    "homepage": "https://github.com/DashedCMS/dashed-ecommerce-rendabiliteit",
    "license": "MIT",
    "authors": [
        {"name": "Robin van Maasakker", "email": "robin@dashed.nl", "role": "Developer"}
    ],
    "require": {
        "php": "^8.3",
        "dashed/dashed-ecommerce-core": "^4.178",
        "filament/filament": "^4.12",
        "openspout/openspout": "^4.23",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.63",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Dashed\\DashedEcommerceRendabiliteit\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dashed\\DashedEcommerceRendabiliteit\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dashed\\DashedEcommerceRendabiliteit\\DashedEcommerceRendabiliteitServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
